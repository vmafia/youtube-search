# FLASK CONFIGURATION
FLASK_ENV=production
SECRET_KEY=generate-a-secure-random-key-here

# ADMIN SECRET (Required for bulk-index and bulk-sync-cc endpoints)
ADMIN_SECRET=generate-a-secure-admin-secret-here

# YOUTUBE API (Optional but recommended to avoid scraping limits)
# YOUTUBE_API_KEY=your_youtube_api_key_here

# AI API KEYS
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Keep transcription fast by default. Run generate_embeddings_backfill.py separately.
ENABLE_INLINE_EMBEDDINGS=false

# DATABASE (Turso)
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token_here

# FIREBASE (Optional)
# FIREBASE_SERVICE_ACCOUNT_JSON=path/to/service-account.json
# FIREBASE_PROJECT_ID=your-project-id

# FRONTEND CONFIGURATION
VITE_API_URL=http://localhost:5000
PORT=3000
